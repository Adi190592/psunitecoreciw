{
  "name": "isr-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Customer outreach and deal-tracking workspace for ISR and Sales teams, on Cloudflare Workers + D1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && wrangler dev",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute isr-workspace --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute isr-workspace --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute isr-workspace --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute isr-workspace --remote --file=./seed.sql",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "wrangler": "^4.33.0"
  }
}
