{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isr-workspace",
  "compatibility_date": "2025-09-01",
  // Static single-page app — no server, no database. The built SPA in ./dist
  // is served directly; data lives in the browser (localStorage).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
